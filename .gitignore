# ============================================================
# 南昌大学 · 人机协同与 AI 编程 · 个人作品集
# .gitignore：告诉 Git 哪些文件“不用上传”，保持仓库干净
# ============================================================

# ---- 操作系统自动生成的文件 ----
.DS_Store
Thumbs.db
Desktop.ini
desktop.ini

# ---- 编辑器 / IDE 的私人配置文件 ----
.vscode/
.idea/
*.swp
*~

# ---- Python 运行缓存（每次运行自动生成，无需上传）----
__pycache__/
*.py[cod]
*$py.class

# ---- Python 虚拟环境（体积大，可用命令随时重建）----
.venv/
venv/
env/
ENV/

# ---- 打包与构建产物 ----
build/
dist/
*.egg-info/
.eggs/

# ---- Jupyter Notebook 检查点 ----
.ipynb_checkpoints/

# ---- 测试与覆盖率报告 ----
.pytest_cache/
.coverage
htmlcov/

# ---- 机密信息（务必不要上传！）----
.env
*.key
*.pem
credentials.json

# ---- 大体积训练产物（模型权重、数据文件等）----
*.pth
*.h5
*.ckpt
